{
  "name": "armoze",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.1 <22 || >=22.12"
  },
  "scripts": {
    "build": "sanity build",
    "check": "npm run lint && npm run typecheck",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "lint": "eslint . --max-warnings=0",
    "start": "sanity start",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:documents": "sanity documents validate --yes --level warning"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^5.26.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.26.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
