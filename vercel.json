{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.armoze.com"
        }
      ],
      "destination": "https://armoze.com/:path*",
      "permanent": true
    },
    {
      "source": "/sanity",
      "destination": "https://sanity.io/@o8e9CGiAz/studio/h2urr4gr3gi7hkputjts782p/default/structure/artworkProduct",
      "permanent": false
    },
    {
      "source": "/sanity/:path*",
      "destination": "https://sanity.io/@o8e9CGiAz/studio/h2urr4gr3gi7hkputjts782p/default/:path*",
      "permanent": false
    }
  ]
}
