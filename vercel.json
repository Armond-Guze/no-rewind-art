{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.armoze.com"
        }
      ],
      "destination": "https://armoze.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|artwork/|armoze-logo.png|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
