{
  "name": "armoze",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node server/index.js\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node server/index.js",
    "sync:artwork": "node scripts/sync-artwork-library.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "test:notification": "node scripts/send-test-order-notification.mjs",
    "build": "npm run sync:artwork && npm run generate:sitemap && tsc -b && vite build && node scripts/clean-production-build.mjs",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sanity/client": "^7.22.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "lucide-react": "latest",
    "pg": "^8.20.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.15.0",
    "resend": "^6.12.3",
    "stripe": "^17.7.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^5.4.21"
  }
}
