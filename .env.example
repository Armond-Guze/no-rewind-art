STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_WEBHOOK_ALLOW_UNSIGNED=false
STRIPE_AUTOMATIC_TAX=false
# General tangible goods. Override this if Stripe recommends a more specific code for your catalog.
STRIPE_PRODUCT_TAX_CODE=txcd_99999999
STRIPE_ALLOW_INSECURE_LOCAL_TLS=false
CLIENT_URL=http://127.0.0.1:3000
PUBLIC_SITE_URL=https://armoze.com
PORT=4242

# Customer accounts in the storefront use Supabase Auth.
# Use either the VITE_ names or the NEXT_PUBLIC_ aliases.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional conversion tracking. Leave blank until the accounts are created.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
VITE_GOOGLE_ADS_PURCHASE_LABEL=
VITE_GOOGLE_ADS_PURCHASE_EVENT_NAME=conversion_event_purchase_1
VITE_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_EVENT_NAME=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Customer Reviews
GOOGLE_CUSTOMER_REVIEWS_MERCHANT_ID=5793512839
NEXT_PUBLIC_GOOGLE_CUSTOMER_REVIEWS_MERCHANT_ID=5793512839
NEXT_PUBLIC_GOOGLE_CUSTOMER_REVIEWS_BADGE_ENABLED=false
NEXT_PUBLIC_GOOGLE_CUSTOMER_REVIEWS_BADGE_POSITION=
NEXT_PUBLIC_GOOGLE_CUSTOMER_REVIEWS_BADGE_REGION=

# Local development works without DATABASE_URL and stores orders/products under ~/.armoze/.
# For production, point this at Supabase/Postgres so orders and product edits persist.
DATABASE_URL=
DATABASE_SSL=true

# Admin dashboard
ADMIN_API_TOKEN=replace_with_a_long_private_admin_token

# Artwork catalog/images can be served from Sanity instead of public/artwork.
# Leave disabled until the Sanity Studio has Artwork Product documents.
SANITY_CATALOG_ENABLED=false
SANITY_PROJECT_ID=os8xckqo
SANITY_DATASET=production
SANITY_API_VERSION=2025-05-21
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN_PRICE=

# Owner notifications
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_FROM=Armoze Orders <orders@resend.dev>

# Optional support-form overrides. Falls back to the owner notification settings above.
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_NOTIFICATION_FROM=Armoze Support <hello@armoze.com>

# Newsletter discount emails
NEWSLETTER_DISCOUNT_FROM=Armoze <hello@armoze.com>
NEWSLETTER_DISCOUNT_CODE=FIRST15
NEWSLETTER_DISCOUNT_LABEL=15%

# Customer emails (order confirmation, shipping updates, abandoned cart).
# Falls back to NEWSLETTER_DISCOUNT_FROM, then ORDER_NOTIFICATION_FROM.
# The abandoned cart email reuses NEWSLETTER_DISCOUNT_CODE / NEWSLETTER_DISCOUNT_LABEL.
CUSTOMER_EMAIL_FROM=Armoze <hello@armoze.com>
