STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_WEBHOOK_ALLOW_UNSIGNED=false
STRIPE_AUTOMATIC_TAX=false
STRIPE_ALLOW_INSECURE_LOCAL_TLS=false
CLIENT_URL=http://127.0.0.1:5173
PORT=4242

# Local development works without DATABASE_URL and stores orders in server/data/orders.json.
# For production, point this at Supabase/Postgres.
DATABASE_URL=
DATABASE_SSL=true

# Admin dashboard
ADMIN_API_TOKEN=replace_with_a_long_private_admin_token

# Owner notifications
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_FROM=Armoze Orders <orders@resend.dev>
